# Copy to .env (untracked) and fill in. `aio app use` appends the AIO_* credentials to .env; never commit it.

# Secret used by GET /hello/sign (any random string; rotate by editing it and redeploying the action).
HELLO_SECRET=

# Comma list of exact extra origins allowed to call the worker.
# Stage: the fixed ref=local dev origin. Production: must be empty (the pre-deploy guard enforces it).
ALLOWED_LOCAL_ORIGINS=http://localhost:3000
