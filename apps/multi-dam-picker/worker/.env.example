# Copy to .env (untracked) and fill in. `aio app use` appends the AIO_* credentials to .env; never commit it.

# Comma list of exact extra origins allowed to call the worker.
# Stage: the fixed ref=local dev origin. Production: must be empty (the pre-deploy guard enforces it).
ALLOWED_LOCAL_ORIGINS=http://localhost:3000

# Cloudinary product environment (non-secret; public in every delivery URL).
CLOUDINARY_CLOUD_NAME=yifoe45l
# Folder the picker is confined to, including its subfolders. Empty = the whole environment.
CLOUDINARY_ROOT_FOLDER=samples/
# `dynamic` (accounts created after 2024-06-04) or `fixed` (legacy); read once with GET /config?settings=true.
CLOUDINARY_FOLDER_MODE=dynamic
# `true` signs every rendition and thumbnail URL on the server (needed when Strict transformations is on).
CLOUDINARY_SIGN_URLS=false

# Cloudinary API credentials (Console > Settings > API Keys). SECRETS: set them only in your untracked .env.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
