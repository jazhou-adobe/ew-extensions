# Copy to .env (untracked) and fill in. `aio app use` appends the AIO_* credentials to .env; never commit it.

# Comma list of exact extra origins allowed to call the worker.
# Stage: the fixed ref=local dev origin. Production: must be empty (the pre-deploy guard enforces it).
ALLOWED_LOCAL_ORIGINS=http://localhost:3000

# Cloudinary product environment (non-secret; public in every delivery URL).
CLOUDINARY_CLOUD_NAME=yifoe45l
# Folder the picker is confined to, including its subfolders. Empty = the whole environment.
CLOUDINARY_ROOT_FOLDER=samples/
# `dynamic` (accounts created after 2024-06-04) or `fixed` (legacy); read once with GET /config?settings=true.
CLOUDINARY_FOLDER_MODE=dynamic
# `true` signs every rendition and thumbnail URL on the server (needed when Strict transformations is on).
CLOUDINARY_SIGN_URLS=false

# Cloudinary API credentials (Console > Settings > API Keys). SECRETS: set them only in your untracked .env.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Per-author OAuth host (needed by Dropbox and every later OAuth DAM). Leave blank for a Cloudinary-only deploy. ---
# The public base URL of the `oauth` action, known after the first deploy (`env -u CI aio app get-url`):
#   https://<namespace>.adobeioruntime.net/api/v1/web/multi-dam-picker/oauth
OAUTH_PUBLIC_BASE_URL=
# Two DIFFERENT random 32-byte base64 keys, generated locally and never shared:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENC_KEY encrypts stored connections; OAUTH_STATE_KEY seals sign-in tickets and states.
TOKEN_ENC_KEY=
OAUTH_STATE_KEY=
# Only while rotating TOKEN_ENC_KEY: the old key, so existing connections still open (then remove it).
TOKEN_ENC_KEY_PREVIOUS=

# --- Dropbox provider. Both blank = Dropbox is not offered. See the README, "Dropbox-side setup". ---
# App key and App secret from https://www.dropbox.com/developers/apps (the secret is a SECRET).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Optional folder the picker is confined to, e.g. /Brand/Images. Blank = the whole Dropbox.
DROPBOX_ROOT_PATH=
