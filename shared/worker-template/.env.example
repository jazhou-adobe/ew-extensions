# Opt-in live tiers (`npm run test:worker:deployed`). Copy to .env (untracked; never commit) or export in the shell.

# --- Deployed worker check (LV1-LV6) ---
# Base URL of the deployed action, no trailing slash: `env -u CI aio app get-url` from apps/hello-world/worker
WORKER_BASE_URL=
# stage | production (LV5 asserts localhost is allowed on stage only)
WORKER_ENV=stage
# A real EW IMS access token copied from DevTools. Expires; never commit, never paste into chat or issues.
IMS_TOKEN=
# Optional: the same HELLO_SECRET as the deployed worker, to compare the signature (otherwise shape-only).
HELLO_SECRET_CHECK=

# --- Cloudinary proxy check (CL1-CL3), non-secret values ---
CLOUDINARY_CLOUD_NAME=yifoe45l
CLOUDINARY_ROOT_FOLDER=samples
# Secrets: leave blank unless you want the live tier
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
